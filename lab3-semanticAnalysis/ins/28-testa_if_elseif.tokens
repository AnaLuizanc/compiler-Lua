FUNCTION function
ID testaElseIf
LPAREN (
ID x
COLON :
ID int
RPAREN )
COLON :
ID int
LOCAL local
ID res
COLON :
ID int
ID res
ASSIGN =
NUMBER 0
IF if
ID x
EQ ==
NUMBER 1
THEN then
ID res
ASSIGN =
NUMBER 10
ELSEIF elseif
ID x
EQ ==
NUMBER 2
THEN then
ID res
ASSIGN =
NUMBER 20
END end
RETURN return
ID res
END end
$ $ 
